# ==== TF2 Scout — configuration ====
# Copy this file to .env and fill in what you have. Everything is optional unless stated otherwise.

# backpack.tf — user token (https://backpack.tf/connections → "Show Token").
# Used for the per-item order book snapshot. Without it, the system runs on the live feed only.
BPTF_TOKEN=

# backpack.tf — API key (https://backpack.tf/developer/apikey/view). Used for IGetPrices/IGetCurrencies/IGetUsers.
BPTF_API_KEY=

# Your SteamID64 (17 digits). Together with BPTF_API_KEY it lets you record your daily backpack value.
STEAM_ID64=

# Discord: webhook URL to receive alerts on your phone (optional).
DISCORD_WEBHOOK_URL=

# STN.trading API key (https://stntrading.eu/dev/apikey) for the keys board (optional).
STN_API_KEY=

# Local dashboard port (and HOST if you expose it outside this PC; localhost only by default).
PORT=4400
HOST=127.0.0.1

# Data folder (SQLite database and caches). Defaults to ./data
DATA_DIR=./data

# Desktop notifications via notify-send (true/false)
DESKTOP_NOTIFY=true
